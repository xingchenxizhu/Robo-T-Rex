  "tail": {
    "_comment": "尾巴是研究的自变量。结构完全由本段配置决定：段数/长度/质量分布/轴向/力矩/速度/阻尼。",
    "segments": 4,
    "length": 1.15,
    "mass": 2.4,
    "segment_mass_ratio": 0.62,
    "base_radius": 0.075,
