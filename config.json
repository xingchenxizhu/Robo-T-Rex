{
  "assumptions": [
    "本模型是【说明性小机器人】，不是真实硬件辨识结果，也不是霸王龙解剖学复原。",
    "单位全部为 SI：米、千克、秒、弧度（XML 内 angle=degree 处除外）。",
    "躯干 8.0 kg、总质量约 15.5 kg、站立髋高 0.785 m：属于桌面上可跑的小型双足机器人量级。",
    "惯量由 MuJoCo 依据几何体（ellipsoid / capsule / box）+ 质量自动计算，未使用实测惯量张量。",
    "地面为刚性平面，摩擦锥 condim=3，滑动摩擦系数见 physics.friction；无地面柔顺与迟滞。",
    "平面阶段（阶段一/二）的根关节用 2 个滑移 + 1 个俯仰铰链约束在矢状面内，这是【声明的实验限制】，不是物理约束。",
    "重力补偿只施加于腿部关节（髋/膝/踝）：假设腿部控制器具备基于模型的支撑力矩。",
    "尾巴、颈、颌【不做重力/科氏补偿】，因此尾巴保留重力垂坠与惯性跟随——这是本研究的自变量，不是人为加的自然感。",
    "所有动作必须由受限关节执行器 + 物理接触产生；不直接改写 qpos/qvel，不施加未声明的辅助力（唯一例外：扰动实验中声明的 xfrc 外力）。",
    "对照实验（fixed / passive / active）共享同一套形态与被动参数，只改变尾关节是否受执行器驱动。"
  ],
  "physics": {
    "timestep": 0.002,
    "control_dt": 0.02,
    "friction": 1.0,
    "solver_iterations": 60,
    "integrator": "implicitfast"
  },
  "robot": {
    "torso_mass": 8.0,
    "torso_size": [0.27, 0.14, 0.16],
    "stand_height": 0.785,
    "thigh_mass": 1.8,
